            {
              "type": "text",
              "id": "uPWI6",
              "name": "About heading",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "We are SILA,  a jewellery brand born in Bali",
              "lineHeight": 0.95,
              "fontFamily": "$font-body",
              "fontSize": 38,
              "fontWeight": "normal"
            },
            {
              "type": "rectangle",
              "id": "OY8Jv",
              "name": "About photo block",
              "fill": "#000000ff",
              "width": 350,
              "height": 394
            },
            {
              "type": "line",
              "id": "hqvmZ",
              "name": "About rule",
              "width": "fill_container",
              "height": 0,
              "stroke": "$ink",
              "strokeWidth": 1
            },
            {
              "type": "text",
              "id": "XE62a",
              "name": "About body",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "We create items, which motivate you to choose yourself above all else and discover your unique personality. Our jewellery is made of high quality silver and we always use natural gemstones. The brand’s symbol has two hidden stones that represent the connection to your authentic self.\n\nFor us, jewellery is not merely a visual addition to your look, but rather, a personal item that helps you to tap into your inner strength and beauty, building the connection between your inner ’self’ and the outside world.\n\nWe are about depth. The one that is clear and easy  to understand, without any underlying ritual meanings or deep sense overload. Without the ‘why’ I should wear it. Our jewellery is real and alive, designed to accompany you every day.",
              "fontFamily": "$font-body",
              "fontSize": 17,
              "fontWeight": "normal"
            }
          ]
        },
