                {
                  "type": "text",
                  "id": "trqke",
                  "x": 815,
                  "y": 4268,
                  "name": "Our jewellery is made of high quality silver and we always use natural gemstones. The brand’s symbol has two hidden stones that represent the connection to your authentic self.",
                  "fill": "#1f1f1fff",
