                {
                  "type": "text",
                  "id": "hJb5T",
                  "x": 769,
                  "y": 2831,
                  "name": "We are SILA,  a jewellery brand born in Bali",
                  "fill": "#1f1f1fff",
                  "textGrowth": "fixed-width",
                  "width": 423,
                  "content": "We are SILA,  a jewellery brand born in Bali",
                  "lineHeight": 0.9166666666666666,
                  "fontFamily": "Belleza",
                  "fontSize": 60,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "xWQmw",
                  "x": 769,
                  "y": 3078,
                  "name": "We create items, which motivate you to choose yourself above all else and discover your unique personality. Our jewellery is made of high quality silver and we always use natural gemstones. The brand’s symbol has two hidden stones that represent the connection to your authentic self. For us, jewellery is not merely a visual addition to your look, but rather, a personal item that helps you to tap into your inner strength and beauty, building the connection between your inner ’self’ and the outside world. We are about depth. The one that is clear and easy  to understand, without any underlying ritual meanings or deep sense overload. Without the ‘why’ I should wear it. Our jewellery is real and alive, designed to accompany you every day.",
                  "fill": "#1f1f1fff",
                  "textGrowth": "fixed-width",
                  "width": 707,
                  "content": "We create items, which motivate you to choose yourself above all else and discover your unique personality. Our jewellery is made of high quality silver and we always use natural gemstones. The brand’s symbol has two hidden stones that represent the connection to your authentic self.\n\nFor us, jewellery is not merely a visual addition to your look, but rather, a personal item that helps you to tap into your inner strength and beauty, building the connection between your inner ’self’ and the outside world.\n\nWe are about depth. The one that is clear and easy  to understand, without any underlying ritual meanings or deep sense overload. Without the ‘why’ I should wear it. Our jewellery is real and alive, designed to accompany you every day.",
                  "fontFamily": "Belleza",
                  "fontSize": 27.5863094329834,
                  "fontWeight": "normal"
                }
              ]
            },
