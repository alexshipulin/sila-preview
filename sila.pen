                    },
                    {
                      "type": "text",
                      "id": "Z7nJI",
                      "x": 133,
                      "y": 1519,
                      "name": "A silver ring shaped by repeated vertical forms, creating a clean architectural rhythm. Minimal from afar, detailed up close. Designed  to become a daily piece with character — structured, calm, and strong.",
                      "fill": "#ffffff80",
                      "textGrowth": "fixed-width",
                      "width": 290,
                      "content": "A silver ring shaped by repeated vertical forms, creating a clean architectural rhythm. Minimal from afar, detailed up close. Designed  to become a daily piece with character — structured, calm, and strong.",
                      "fontFamily": "Archivo",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "dwKcw",
                      "x": 623,
                      "y": 1519,
                      "name": "A sculptural silver ring built from small rounded elements, creating a soft open structure around the finger. Light-catching, tactile, and bold without feeling heavy. A piece for everyday presence — noticeable, but never loud.",
                      "fill": "#ffffff80",
                      "textGrowth": "fixed-width",
                      "width": 290,
                      "content": "A sculptural silver ring built from small rounded elements, creating a soft open structure around the finger. Light-catching, tactile, and bold without feeling heavy. A piece for everyday presence — noticeable, but never loud.",
                      "fontFamily": "Archivo",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "zULT8",
                      "x": 1111,
                      "y": 1519,
                      "name": "A smooth silver signet ring with a warm zircon stone at the center. Its rounded form feels calm and grounded, while the stone adds a quiet point of light. Inside, ttwo small stones symbolize a connection with yourself.",
                      "fill": "#ffffff80",
                      "textGrowth": "fixed-width",
                      "width": 290,
                      "content": "A smooth silver signet ring with a warm zircon stone at the center. Its rounded form feels calm and grounded, while the stone adds a quiet point of light. Inside, ttwo small stones symbolize a connection with yourself.",
