            {
              "type": "text",
              "id": "wx8It",
              "x": 20,
              "y": 630,
              "name": "About body",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": 350,
              "content": "We create items, which motivate you to choose yourself above all else and discover your unique personality. Our jewellery is made of high quality silver and we always use natural gemstones. The brand’s symbol has two hidden stones that represent the connection to your authentic self.\n\nFor us, jewellery is not merely a visual addition to your look, but rather, a personal item that helps you to tap into your inner strength and beauty, building the connection between your inner ’self’ and the outside world.",
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
