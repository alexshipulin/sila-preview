                {
                  "type": "text",
                  "id": "wqoVG",
                  "x": 815,
                  "y": 4638,
                  "name": "For us, jewellery is not merely a visual addition to your look, but rather, a personal item that helps you to tap into your inner strength and beauty, building the connection between your inner ’self’ and the outside world.",
                  "fill": "#1f1f1fff",
                  "textGrowth": "fixed-width",
