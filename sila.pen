              "textGrowth": "fixed-width",
              "width": 240,
              "content": "We are SILA,  a jewellery brand born in Bali",
              "lineHeight": 0.95,
              "fontFamily": "$font-body",
              "fontSize": 34,
              "fontWeight": "normal"
            },
            {
              "type": "line",
